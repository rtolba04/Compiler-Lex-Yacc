    on left: 45 46, on right: 7
while_stmt (57)
    on left: 47, on right: 8
for_stmt (58)
    on left: 48, on right: 9
switch_stmt (59)
    on left: 49 50, on right: 10
case_list (60)
    on left: 51 52, on right: 49 50 52
case_stmt (61)
    on left: 53 54, on right: 51 52
default_case (62)
    on left: 55 56, on right: 50
function_decl (63)
    on left: 57 58 59, on right: 11
parameter_list (64)
    on left: 60 61, on right: 57 59 61
parameter (65)
    on left: 62, on right: 60 61
return_stmt (66)
    on left: 63 64, on right: 13
do_while_stmt (67)
    on left: 65, on right: 12
function_call (68)
    on left: 66 67, on right: 14
argument_list (69)
    on left: 68 69, on right: 66 69


state 0

    0 $accept: . program $end

    INT          shift, and go to state 1
    FLOAT_TYPE   shift, and go to state 2
    STRING_TYPE  shift, and go to state 3
    CHAR_TYPE    shift, and go to state 4
    CONST        shift, and go to state 5
    IF           shift, and go to state 6
    WHILE        shift, and go to state 7
    FOR          shift, and go to state 8
    DO           shift, and go to state 9
    SWITCH       shift, and go to state 10
    RETURN       shift, and go to state 11
    VOID_TYPE    shift, and go to state 12
    MINUS        shift, and go to state 13
    LPAREN       shift, and go to state 14
    IDENTIFIER   shift, and go to state 15
    NUMBER       shift, and go to state 16
    FLOAT        shift, and go to state 17

    program           go to state 18
    statement_list    go to state 19
    statement         go to state 20
    declaration_stmt  go to state 21
    type              go to state 22
    assignment_stmt   go to state 23
    expression        go to state 24
    T                 go to state 25
    F                 go to state 26
    if_stmt           go to state 27
    while_stmt        go to state 28
    for_stmt          go to state 29
    switch_stmt       go to state 30
    function_decl     go to state 31
    return_stmt       go to state 32
    do_while_stmt     go to state 33
    function_call     go to state 34


