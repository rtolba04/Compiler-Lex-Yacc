Grammar

    0 $accept: program $end

    1 $@1: /* empty */

    2 program: $@1 statement_list

    3 statement_list: statement
    4               | statement_list statement

    5 statement: declaration_stmt
    6          | assignment_stmt
    7          | expression SEMICOLON
    8          | if_stmt
    9          | while_stmt
   10          | for_stmt
   11          | switch_stmt
   12          | function_decl
   13          | do_while_stmt
   14          | return_stmt

   15 declaration_stmt: type IDENTIFIER SEMICOLON
   16                 | CONST type IDENTIFIER ASSIGN expression SEMICOLON
   17                 | type IDENTIFIER ASSIGN expression SEMICOLON
   18                 | BOOL_TYPE IDENTIFIER SEMICOLON
   19                 | BOOL_TYPE IDENTIFIER ASSIGN bool_expression SEMICOLON

   20 bool_expression: TRUE_COND
   21                | FALSE_COND
   22                | LPAREN condition RPAREN

   23 type: INT
   24     | FLOAT_TYPE
   25     | STRING_TYPE
   26     | CHAR_TYPE

   27 assignment_stmt: IDENTIFIER ASSIGN expression SEMICOLON

   28 assign: IDENTIFIER ASSIGN expression

   29 expression: expression PLUS T
   30           | expression MINUS T
   31           | T

   32 T: T MULTIPLY F
   33  | T DIVIDE F
   34  | T MODULO F
   35  | F

   36 F: LPAREN condition RPAREN
   37  | MINUS F
   38  | IDENTIFIER
   39  | IDENTIFIER LPAREN argument_list RPAREN
   40  | IDENTIFIER LPAREN RPAREN
   41  | FLOAT
   42  | NUMBER
   43  | TRUE_COND
   44  | FALSE_COND

   45 condition: expression EQUAL expression
   46          | expression NOT_EQUAL expression
   47          | expression LESS_THAN expression
   48          | expression GREATER_THAN expression
   49          | expression LESS_EQUAL expression
   50          | expression GREATER_EQUAL expression
   51          | expression AND expression
   52          | expression OR expression
   53          | NOT expression
   54          | expression

   55 if_stmt: IF LPAREN condition RPAREN scope_start statement_list scope_end
   56        | IF LPAREN condition RPAREN scope_start statement_list scope_end ELSE scope_start statement_list scope_end

   57 $@2: /* empty */

   58 $@3: /* empty */

   59 while_stmt: WHILE LPAREN condition RPAREN LBRACE $@2 statement_list RBRACE $@3

   60 $@4: /* empty */

   61 $@5: /* empty */

   62 for_stmt: FOR LPAREN declaration_stmt condition SEMICOLON assign RPAREN LBRACE $@4 statement_list RBRACE $@5

   63 switch_stmt: SWITCH LPAREN IDENTIFIER RPAREN scope_start case_list scope_end
   64            | SWITCH LPAREN IDENTIFIER RPAREN scope_start case_list default_case scope_end

   65 scope_start: LBRACE

   66 scope_end: RBRACE

   67 case_list: case_stmt
   68          | case_list case_stmt

   69 case_stmt: CASE expression COLON statement_list
   70          | CASE expression COLON statement_list BREAK SEMICOLON

   71 default_case: DEFAULT COLON statement_list
   72             | DEFAULT COLON statement_list BREAK SEMICOLON

   73 $@6: /* empty */

   74 $@7: /* empty */

   75 function_decl: type IDENTIFIER LPAREN parameter_list RPAREN LBRACE $@6 statement_list RBRACE $@7

   76 $@8: /* empty */

   77 $@9: /* empty */

   78 function_decl: type IDENTIFIER LPAREN RPAREN LBRACE $@8 statement_list RBRACE $@9

   79 $@10: /* empty */

   80 $@11: /* empty */

   81 function_decl: VOID_TYPE IDENTIFIER LPAREN parameter_list RPAREN LBRACE $@10 statement_list RBRACE $@11

   82 parameter_list: parameter
   83               | parameter_list COMMA parameter

   84 parameter: type IDENTIFIER

   85 return_stmt: RETURN expression SEMICOLON
   86            | RETURN SEMICOLON

   87 $@12: /* empty */

   88 $@13: /* empty */

   89 do_while_stmt: DO LBRACE $@12 statement_list RBRACE $@13 WHILE LPAREN condition RPAREN SEMICOLON

   90 argument_list: expression
   91              | argument_list COMMA expression


