Grammar

    0 $accept: program $end

    1 $@1: /* empty */

    2 program: $@1 global_list

    3 global_list: global_element
    4            | global_list global_element

    5 global_element: function_decl
    6               | declaration_stmt

    7 statement_list: statement
    8               | statement_list statement

    9 statement: declaration_stmt
   10          | assignment_stmt
   11          | expression SEMICOLON
   12          | if_stmt
   13          | while_stmt
   14          | for_stmt
   15          | switch_stmt
   16          | function_decl
   17          | do_while_stmt
   18          | return_stmt
   19          | break_stmt
   20          | block

   21 break_stmt: BREAK SEMICOLON

   22 $@2: /* empty */

   23 block: LBRACE $@2 statement_list RBRACE

   24 declaration_stmt: type IDENTIFIER SEMICOLON
   25                 | CONST type IDENTIFIER ASSIGN expression SEMICOLON
   26                 | type IDENTIFIER ASSIGN expression SEMICOLON
   27                 | BOOL_TYPE IDENTIFIER SEMICOLON
   28                 | BOOL_TYPE IDENTIFIER ASSIGN bool_expression SEMICOLON
   29                 | type error SEMICOLON
   30                 | CONST type error SEMICOLON

   31 bool_expression: TRUE_COND
   32                | FALSE_COND
   33                | LPAREN condition RPAREN

   34 type: INT
   35     | FLOAT_TYPE
   36     | STRING_TYPE
   37     | CHAR_TYPE

   38 assignment_stmt: IDENTIFIER ASSIGN expression SEMICOLON
   39                | error ASSIGN expression SEMICOLON
   40                | IDENTIFIER ASSIGN error SEMICOLON

   41 assign: IDENTIFIER ASSIGN expression

   42 expression: expression PLUS T
   43           | expression MINUS T
   44           | T

   45 T: T MULTIPLY F
   46  | T DIVIDE F
   47  | T MODULO F
   48  | F

   49 F: LPAREN condition RPAREN
   50  | MINUS F
   51  | IDENTIFIER
   52  | IDENTIFIER LPAREN argument_list RPAREN
   53  | IDENTIFIER LPAREN RPAREN
   54  | FLOAT
   55  | NUMBER
   56  | STRING_LITERAL
   57  | CHAR_LITERAL
   58  | TRUE_COND
   59  | FALSE_COND

   60 condition: expression EQUAL expression
   61          | expression NOT_EQUAL expression
   62          | expression LESS_THAN expression
   63          | expression GREATER_THAN expression
   64          | expression LESS_EQUAL expression
   65          | expression GREATER_EQUAL expression
   66          | expression AND expression
   67          | expression OR expression
   68          | NOT expression
   69          | expression

   70 M_if: /* empty */

   71 $@3: /* empty */

   72 if_stmt: if_begin ELSE $@3 else_block
   73        | if_begin

   74 $@4: /* empty */

   75 if_begin: IF LPAREN condition RPAREN M_if $@4 if_block

   76 $@5: /* empty */

   77 $@6: /* empty */

   78 if_block: LBRACE $@5 statement_list $@6 RBRACE

   79 $@7: /* empty */

   80 $@8: /* empty */

   81 else_block: LBRACE $@7 statement_list $@8 RBRACE

   82 M_while: /* empty */

   83 $@9: /* empty */

   84 $@10: /* empty */

   85 $@11: /* empty */

   86 while_stmt: WHILE M_while LPAREN condition RPAREN $@9 LBRACE $@10 statement_list $@11 RBRACE

   87 $@12: /* empty */

   88 @13: /* empty */

   89 @14: /* empty */

   90 $@15: /* empty */

   91 $@16: /* empty */

   92 $@17: /* empty */

   93 for_stmt: FOR $@12 LPAREN declaration_stmt @13 condition @14 SEMICOLON $@15 assign $@16 RPAREN $@17 LBRACE statement_list RBRACE
   94         | FOR error RPAREN LBRACE statement_list RBRACE

   95 $@18: /* empty */

   96 switch_stmt: SWITCH LPAREN IDENTIFIER RPAREN $@18 LBRACE case_list switch_optional_default RBRACE
   97            | SWITCH error RPAREN LBRACE case_list RBRACE

   98 switch_optional_default: default_case
   99                        | /* empty */

  100 case_list: case_stmt
  101          | case_list case_stmt

  102 case_stmt: CASE expression COLON statement_list

  103 default_case: DEFAULT COLON statement_list

  104 function_decl: function_name LPAREN parameter_list RPAREN LBRACE statement_list RBRACE
  105              | function_name LPAREN RPAREN LBRACE statement_list RBRACE
  106              | function_name_void LPAREN parameter_list RPAREN LBRACE statement_list RBRACE
  107              | function_name_void LPAREN RPAREN LBRACE statement_list RBRACE

  108 function_name: type IDENTIFIER

  109 function_name_void: VOID_TYPE IDENTIFIER

  110 parameter_list: parameter
  111               | parameter_list COMMA parameter

  112 parameter: type IDENTIFIER

  113 return_stmt: RETURN expression SEMICOLON
  114            | RETURN SEMICOLON

  115 M_do: /* empty */

  116 do_while_stmt: DO M_do do_block WHILE LPAREN condition RPAREN SEMICOLON
  117              | DO error SEMICOLON

  118 $@19: /* empty */

  119 $@20: /* empty */

  120 $@21: /* empty */

  121 do_block: $@19 LBRACE $@20 statement_list $@21 RBRACE

  122 argument_list: expression
  123              | argument_list COMMA expression


