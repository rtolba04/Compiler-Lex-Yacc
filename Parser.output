state 0

    0 $accept: . program $end

    INT          shift, and go to state 1
    FLOAT_TYPE   shift, and go to state 2
    STRING_TYPE  shift, and go to state 3
    CHAR_TYPE    shift, and go to state 4
    CONST        shift, and go to state 5
    BOOL_TYPE    shift, and go to state 6
    IF           shift, and go to state 7
    WHILE        shift, and go to state 8
    FOR          shift, and go to state 9
    DO           shift, and go to state 10
    SWITCH       shift, and go to state 11
    RETURN       shift, and go to state 12
    VOID_TYPE    shift, and go to state 13
    TRUE_COND    shift, and go to state 14
    FALSE_COND   shift, and go to state 15
    MINUS        shift, and go to state 16
    LPAREN       shift, and go to state 17
    IDENTIFIER   shift, and go to state 18
    NUMBER       shift, and go to state 19
    FLOAT        shift, and go to state 20

    program           go to state 21
    statement_list    go to state 22
    statement         go to state 23
    declaration_stmt  go to state 24
    type              go to state 25
    assignment_stmt   go to state 26
    expression        go to state 27
    T                 go to state 28
    F                 go to state 29
    if_stmt           go to state 30
    while_stmt        go to state 31
    for_stmt          go to state 32
    switch_stmt       go to state 33
    function_decl     go to state 34
    return_stmt       go to state 35
    do_while_stmt     go to state 36


