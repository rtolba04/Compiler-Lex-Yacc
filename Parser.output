Grammar

    0 $accept: program $end

    1 $@1: /* empty */

    2 program: $@1 statement_list

    3 statement_list: statement
    4               | statement_list statement

    5 statement: declaration_stmt
    6          | assignment_stmt
    7          | expression SEMICOLON
    8          | if_stmt
    9          | while_stmt
   10          | for_stmt
   11          | switch_stmt
   12          | function_decl
   13          | do_while_stmt
   14          | return_stmt

   15 declaration_stmt: type IDENTIFIER SEMICOLON
   16                 | CONST type IDENTIFIER ASSIGN expression SEMICOLON
   17                 | type IDENTIFIER ASSIGN expression SEMICOLON
   18                 | BOOL_TYPE IDENTIFIER SEMICOLON
   19                 | BOOL_TYPE IDENTIFIER ASSIGN bool_expression SEMICOLON

   20 bool_expression: TRUE_COND
   21                | FALSE_COND
   22                | LPAREN condition RPAREN

   23 type: INT
   24     | FLOAT_TYPE
   25     | STRING_TYPE
   26     | CHAR_TYPE

   27 assignment_stmt: IDENTIFIER ASSIGN expression SEMICOLON

   28 assign: IDENTIFIER ASSIGN expression

   29 expression: expression PLUS T
   30           | expression MINUS T
   31           | T

   32 T: T MULTIPLY F
   33  | T DIVIDE F
   34  | T MODULO F
   35  | F

   36 F: LPAREN condition RPAREN
   37  | MINUS F
   38  | IDENTIFIER
   39  | IDENTIFIER LPAREN argument_list RPAREN
   40  | IDENTIFIER LPAREN RPAREN
   41  | FLOAT
   42  | NUMBER
   43  | TRUE_COND
   44  | FALSE_COND

   45 condition: expression EQUAL expression
   46          | expression NOT_EQUAL expression
   47          | expression LESS_THAN expression
   48          | expression GREATER_THAN expression
   49          | expression LESS_EQUAL expression
   50          | expression GREATER_EQUAL expression
   51          | expression AND expression
   52          | expression OR expression
   53          | NOT expression
   54          | expression

   55 if_stmt: if_begin LPAREN condition RPAREN LBRACE statement_list scope_end

   56 $@2: /* empty */

   57 if_stmt: if_begin LPAREN condition RPAREN LBRACE statement_list scope_end ELSE $@2 LBRACE statement_list scope_end

   58 if_begin: IF

   59 $@3: /* empty */

   60 $@4: /* empty */

   61 while_stmt: WHILE $@3 LPAREN condition RPAREN LBRACE statement_list RBRACE $@4

   62 $@5: /* empty */

   63 $@6: /* empty */

   64 for_stmt: FOR $@5 LPAREN declaration_stmt condition SEMICOLON assign RPAREN LBRACE statement_list RBRACE $@6

   65 switch_stmt: SWITCH LPAREN IDENTIFIER RPAREN scope_start case_list scope_end
   66            | SWITCH LPAREN IDENTIFIER RPAREN scope_start case_list default_case scope_end

   67 scope_start: LBRACE

   68 scope_end: RBRACE

   69 case_list: case_stmt
   70          | case_list case_stmt

   71 case_stmt: CASE expression COLON statement_list
   72          | CASE expression COLON statement_list BREAK SEMICOLON

   73 default_case: DEFAULT COLON statement_list
   74             | DEFAULT COLON statement_list BREAK SEMICOLON

   75 function_decl: function_name LPAREN parameter_list RPAREN LBRACE statement_list scope_end
   76              | function_name LPAREN RPAREN LBRACE statement_list scope_end
   77              | function_name_void LPAREN parameter_list RPAREN LBRACE statement_list scope_end
   78              | function_name_void LPAREN RPAREN LBRACE statement_list scope_end

   79 function_name: type IDENTIFIER

   80 function_name_void: VOID_TYPE IDENTIFIER

   81 parameter_list: parameter
   82               | parameter_list COMMA parameter

   83 parameter: type IDENTIFIER

   84 return_stmt: RETURN expression SEMICOLON
   85            | RETURN SEMICOLON

   86 $@7: /* empty */

   87 do_while_stmt: DO LBRACE $@7 statement_list RBRACE WHILE LPAREN condition RPAREN SEMICOLON

   88 argument_list: expression
   89              | argument_list COMMA expression


