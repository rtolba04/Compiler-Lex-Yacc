Grammar

    0 $accept: program $end

    1 $@1: /* empty */

    2 program: $@1 global_list

    3 global_list: global_element
    4            | global_list global_element

    5 global_element: function_decl
    6               | declaration_stmt

    7 statement_list: statement
    8               | statement_list statement

    9 statement: declaration_stmt
   10          | assignment_stmt
   11          | expression SEMICOLON
   12          | if_stmt
   13          | while_stmt
   14          | for_stmt
   15          | switch_stmt
   16          | function_decl
   17          | do_while_stmt
   18          | return_stmt
   19          | break_stmt
   20          | block

   21 break_stmt: BREAK SEMICOLON

   22 $@2: /* empty */

   23 block: LBRACE $@2 statement_list RBRACE

   24 declaration_stmt: type IDENTIFIER SEMICOLON
   25                 | CONST type IDENTIFIER ASSIGN expression SEMICOLON
   26                 | type IDENTIFIER ASSIGN expression SEMICOLON
   27                 | BOOL_TYPE IDENTIFIER SEMICOLON
   28                 | BOOL_TYPE IDENTIFIER ASSIGN bool_expression SEMICOLON
   29                 | type error SEMICOLON
   30                 | CONST type error SEMICOLON

   31 bool_expression: TRUE_COND
   32                | FALSE_COND
   33                | LPAREN condition RPAREN

   34 type: INT
   35     | FLOAT_TYPE
   36     | STRING_TYPE
   37     | CHAR_TYPE

   38 assignment_stmt: IDENTIFIER ASSIGN expression SEMICOLON
   39                | error ASSIGN expression SEMICOLON
   40                | IDENTIFIER ASSIGN error SEMICOLON

   41 assign: IDENTIFIER ASSIGN expression

   42 expression: expression PLUS T
   43           | expression MINUS T
   44           | T

   45 T: T MULTIPLY F
   46  | T DIVIDE F
   47  | T MODULO F
   48  | F

   49 F: LPAREN condition RPAREN
   50  | MINUS F
   51  | IDENTIFIER
   52  | IDENTIFIER LPAREN argument_list RPAREN
   53  | IDENTIFIER LPAREN RPAREN
   54  | FLOAT
   55  | NUMBER
   56  | TRUE_COND
   57  | FALSE_COND

   58 condition: expression EQUAL expression
   59          | expression NOT_EQUAL expression
   60          | expression LESS_THAN expression
   61          | expression GREATER_THAN expression
   62          | expression LESS_EQUAL expression
   63          | expression GREATER_EQUAL expression
   64          | expression AND expression
   65          | expression OR expression
   66          | NOT expression
   67          | expression

   68 if_stmt: IF LPAREN condition RPAREN if_block
   69        | IF LPAREN condition RPAREN if_block ELSE else_block

   70 $@3: /* empty */

   71 $@4: /* empty */

   72 if_block: LBRACE $@3 statement_list $@4 RBRACE

   73 $@5: /* empty */

   74 $@6: /* empty */

   75 else_block: LBRACE $@5 statement_list $@6 RBRACE

   76 $@7: /* empty */

   77 $@8: /* empty */

   78 $@9: /* empty */

   79 while_stmt: WHILE LPAREN condition RPAREN $@7 LBRACE $@8 statement_list $@9 RBRACE

   80 $@10: /* empty */

   81 $@11: /* empty */

   82 for_stmt: FOR $@10 LPAREN declaration_stmt condition SEMICOLON assign RPAREN $@11 LBRACE statement_list RBRACE

   83 $@12: /* empty */

   84 switch_stmt: SWITCH LPAREN IDENTIFIER RPAREN $@12 LBRACE case_list switch_optional_default RBRACE
   85            | SWITCH error RPAREN LBRACE case_list RBRACE

   86 switch_optional_default: default_case
   87                        | /* empty */

   88 case_list: case_stmt
   89          | case_list case_stmt

   90 case_stmt: CASE expression COLON statement_list

   91 default_case: DEFAULT COLON statement_list

   92 function_decl: function_name LPAREN parameter_list RPAREN LBRACE statement_list RBRACE
   93              | function_name LPAREN RPAREN LBRACE statement_list RBRACE
   94              | function_name_void LPAREN parameter_list RPAREN LBRACE statement_list RBRACE
   95              | function_name_void LPAREN RPAREN LBRACE statement_list RBRACE

   96 function_name: type IDENTIFIER

   97 function_name_void: VOID_TYPE IDENTIFIER

   98 parameter_list: parameter
   99               | parameter_list COMMA parameter

  100 parameter: type IDENTIFIER

  101 return_stmt: RETURN expression SEMICOLON
  102            | RETURN SEMICOLON

  103 $@13: /* empty */

  104 $@14: /* empty */

  105 $@15: /* empty */

  106 $@16: /* empty */

  107 do_while_stmt: DO $@13 LBRACE $@14 statement_list $@15 RBRACE $@16 WHILE LPAREN condition RPAREN SEMICOLON

  108 argument_list: expression
  109              | argument_list COMMA expression


