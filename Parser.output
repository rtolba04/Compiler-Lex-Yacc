Grammar

    0 $accept: program $end

    1 $@1: /* empty */

    2 program: $@1 global_list

    3 global_list: global_element
    4            | global_list global_element

    5 global_element: function_decl
    6               | declaration_stmt

    7 statement_list: statement
    8               | statement_list statement

    9 statement: declaration_stmt
   10          | assignment_stmt
   11          | expression SEMICOLON
   12          | expression error
   13          | if_stmt
   14          | while_stmt
   15          | for_stmt
   16          | switch_stmt
   17          | function_decl
   18          | do_while_stmt
   19          | return_stmt
   20          | break_stmt
   21          | block

   22 break_stmt: BREAK SEMICOLON
   23           | BREAK error

   24 $@2: /* empty */

   25 block: LBRACE $@2 statement_list RBRACE

   26 declaration_stmt: type IDENTIFIER SEMICOLON
   27                 | type IDENTIFIER error
   28                 | CONST type IDENTIFIER ASSIGN expression SEMICOLON
   29                 | CONST type IDENTIFIER ASSIGN expression error
   30                 | type IDENTIFIER ASSIGN expression SEMICOLON
   31                 | type IDENTIFIER ASSIGN expression error
   32                 | BOOL_TYPE IDENTIFIER SEMICOLON
   33                 | BOOL_TYPE IDENTIFIER error
   34                 | BOOL_TYPE IDENTIFIER ASSIGN bool_expression SEMICOLON
   35                 | BOOL_TYPE IDENTIFIER ASSIGN bool_expression error
   36                 | type error SEMICOLON
   37                 | CONST type error SEMICOLON

   38 bool_expression: TRUE_COND
   39                | FALSE_COND
   40                | LPAREN condition RPAREN

   41 type: INT
   42     | FLOAT_TYPE
   43     | STRING_TYPE
   44     | CHAR_TYPE

   45 assignment_stmt: IDENTIFIER ASSIGN expression SEMICOLON
   46                | IDENTIFIER ASSIGN expression error
   47                | error ASSIGN expression SEMICOLON
   48                | IDENTIFIER ASSIGN error SEMICOLON

   49 assign: IDENTIFIER ASSIGN expression

   50 expression: expression PLUS T
   51           | expression MINUS T
   52           | T

   53 T: T MULTIPLY F
   54  | T DIVIDE F
   55  | T MODULO F
   56  | F

   57 F: LPAREN condition RPAREN
   58  | MINUS F
   59  | IDENTIFIER
   60  | IDENTIFIER LPAREN argument_list RPAREN
   61  | IDENTIFIER LPAREN RPAREN
   62  | FLOAT
   63  | NUMBER
   64  | STRING_LITERAL
   65  | CHAR_LITERAL
   66  | TRUE_COND
   67  | FALSE_COND

   68 condition: expression EQUAL expression
   69          | expression NOT_EQUAL expression
   70          | expression LESS_THAN expression
   71          | expression GREATER_THAN expression
   72          | expression LESS_EQUAL expression
   73          | expression GREATER_EQUAL expression
   74          | expression AND expression
   75          | expression OR expression
   76          | NOT expression
   77          | expression

   78 M_if: /* empty */

   79 $@3: /* empty */

   80 if_stmt: if_begin ELSE $@3 else_block
   81        | if_begin

   82 $@4: /* empty */

   83 if_begin: IF LPAREN condition RPAREN M_if $@4 if_block

   84 $@5: /* empty */

   85 $@6: /* empty */

   86 if_block: LBRACE $@5 statement_list $@6 RBRACE

   87 $@7: /* empty */

   88 $@8: /* empty */

   89 else_block: LBRACE $@7 statement_list $@8 RBRACE

   90 M_while: /* empty */

   91 $@9: /* empty */

   92 $@10: /* empty */

   93 $@11: /* empty */

   94 while_stmt: WHILE M_while LPAREN condition RPAREN $@9 LBRACE $@10 statement_list $@11 RBRACE

   95 $@12: /* empty */

   96 @13: /* empty */

   97 @14: /* empty */

   98 $@15: /* empty */

   99 $@16: /* empty */

  100 $@17: /* empty */

  101 for_stmt: FOR $@12 LPAREN declaration_stmt @13 condition @14 SEMICOLON $@15 assign $@16 RPAREN $@17 LBRACE statement_list RBRACE
  102         | FOR error RPAREN LBRACE statement_list RBRACE

  103 $@18: /* empty */

  104 switch_stmt: SWITCH LPAREN IDENTIFIER RPAREN $@18 LBRACE case_list switch_optional_default RBRACE
  105            | SWITCH error RPAREN LBRACE case_list RBRACE

  106 switch_optional_default: default_case
  107                        | /* empty */

  108 case_list: case_stmt
  109          | case_list case_stmt

  110 @19: /* empty */

  111 case_stmt: CASE expression @19 COLON statement_list

  112 default_case: DEFAULT COLON statement_list

  113 function_decl: function_name LPAREN parameter_list RPAREN LBRACE statement_list RBRACE
  114              | function_name LPAREN RPAREN LBRACE statement_list RBRACE
  115              | function_name_void LPAREN parameter_list RPAREN LBRACE statement_list RBRACE
  116              | function_name_void LPAREN RPAREN LBRACE statement_list RBRACE

  117 function_name: type IDENTIFIER

  118 function_name_void: VOID_TYPE IDENTIFIER

  119 parameter_list: parameter
  120               | parameter_list COMMA parameter

  121 parameter: type IDENTIFIER

  122 return_stmt: RETURN expression SEMICOLON
  123            | RETURN expression error
  124            | RETURN SEMICOLON
  125            | RETURN error

  126 M_do: /* empty */

  127 do_while_stmt: DO M_do do_block WHILE LPAREN condition RPAREN SEMICOLON
  128              | DO M_do do_block WHILE LPAREN condition RPAREN error
  129              | DO error SEMICOLON

  130 $@20: /* empty */

  131 $@21: /* empty */

  132 $@22: /* empty */

  133 do_block: $@20 LBRACE $@21 statement_list $@22 RBRACE

  134 argument_list: expression
  135              | argument_list COMMA expression


