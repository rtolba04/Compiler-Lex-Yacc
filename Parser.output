    MINUS        shift, and go to state 19
    LPAREN       shift, and go to state 20
    IDENTIFIER   shift, and go to state 21
    NUMBER       shift, and go to state 22
    FLOAT        shift, and go to state 23

    statement_list    go to state 24
    statement         go to state 25
    declaration_stmt  go to state 26
    type              go to state 27
    assignment_stmt   go to state 28
    expression        go to state 29
    T                 go to state 30
    F                 go to state 31
    if_stmt           go to state 32
    while_stmt        go to state 33
    for_stmt          go to state 34
    switch_stmt       go to state 35
    function_decl     go to state 36
    return_stmt       go to state 37
    do_while_stmt     go to state 38


